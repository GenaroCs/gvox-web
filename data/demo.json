  "publicaciones": [
    {
      "id": "post-mika",
      "usuarioId": "mika",
      "juegoId": "metaphor-refantazio",
      "texto": "Me desvié de la misión para explorar y acabé encontrando este lugar. Cero arrepentimientos. ¿Qué zona les sorprendió más?",
      "imagenId": "post_01"
    },
    {
      "id": "post-ren",
      "usuarioId": "ren",
      "juegoId": "persona-3-reload",
      "texto": "La banda sonora de Persona 3 ya se quedó en mi lista de estudio. Hoy avanzo un poco en el Tártaro; sin spoilers, por favor.",
      "imagenId": "post_02"
    },
    {
      "id": "post-lyra",
      "usuarioId": "lyra",
      "juegoId": "hades-ii",
      "texto": "Llegué al jefe con muy poca vida y casi sale. Mañana pruebo otra combinación de bendiciones. ¿Alguna favorita?",
      "imagenId": "post_03"
    }
  ],
  "resenas": [
    {
      "id": "resena-mika",
      "usuarioId": "mika",
      "juegoId": "metaphor-refantazio",
      "puntuacion": 5,
      "texto": "El sistema de arquetipos me hizo cambiar de equipo varias veces. Los primeros combates explican mucho, pero después puedes experimentar bastante. Lo jugaría con tiempo para leer los diálogos.",
      "verificada": true,
      "recomienda": true
    },
    {
      "id": "resena-ren",
      "usuarioId": "ren",
      "juegoId": "persona-5-royal",
      "puntuacion": 5,
      "texto": "Vine por la música y terminé encariñándome con el grupo. Ojo: el arranque es largo. Si te gustan los RPG por turnos, vale la pena pasar esas primeras horas.",
      "verificada": true,
      "recomienda": true
    },
    {
      "id": "resena-lyra",
      "usuarioId": "lyra",
      "juegoId": "hades-ii",
      "puntuacion": 4,
      "texto": "El combate se siente ágil y cada intento enseña algo. A mí me cuesta dejarlo tras una sola partida. Algunas armas me funcionan mucho mejor que otras; todavía estoy probando.",
      "verificada": true,
      "recomienda": true
    }
  ],
